class Solution {
public:
    int minEatingSpeed(vector<int>& piles, int hr) 
    {
        int h = *max_element(piles.begin(), piles.end());
        int l = 1;
        while(l<h)
        {
            int sum =0;
            int m = (h+l)/2;
            for(int i : piles)
            {
                sum+= (i+m-1)/m;
            }
            if(sum<=hr)
            {
                h = m;
            }
            else
            {
                l = m+1;
            }
        }
        return h;
        
    }
};
