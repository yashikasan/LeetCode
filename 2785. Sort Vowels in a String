class Solution {
public:
    string sortVowels(string s) 
    {
        vector<int> mp;
        vector<int> out;
        for(int i = 0; i < s.size(); i++)
        {
            if(s[i] == 'a'|| s[i] == 'e' || s[i] == 'i'|| s[i] == 'o'|| s[i] == 'u'
                || s[i] == 'A'|| s[i] == 'E'|| s[i] == 'I'|| s[i] == 'O'|| s[i] == 'U')
                {
                    //int ok = s[i]-'a';
                    int ok = s[i];
                    mp.push_back(ok);
                }
        }
            sort(mp.begin(), mp.end());
            int j = 0;
            for(int i = 0; i<s.size(); i++)
            {
                if(s[i] == 'a'|| s[i] == 'e' || s[i] == 'i'|| s[i] == 'o'|| s[i] == 'u'
                || s[i] == 'A'|| s[i] == 'E'|| s[i] == 'I'|| s[i] == 'O'|| s[i] == 'U')
                {
                    out.push_back(mp[j]);
                    j++;
                }
                else
                {
                    out.push_back(s[i]);
                }
            }              
        string nm(out.begin(), out.end());
        return nm;
    }
};
